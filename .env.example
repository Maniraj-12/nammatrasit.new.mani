# Standard static NammaTransit AI GTFS route planning needs no API keys.
#
# TomTom traffic-aware MTC comparisons (optional, no Google billing).
# Register for a free TomTom account at https://my.tomtom.com/
# Set TOMTOM_API_KEY as a PRIVATE server-side secret, never VITE_.
TOMTOM_API_KEY=
TOMTOM_TRAFFIC_ENABLED=false

# Optional: the old Google comparison backend remains available in code
# but is unused by the current TomTom traffic panel. Keep Google disabled.
GOOGLE_MAPS_ROUTES_API_KEY=
TRAFFIC_API_ENABLED=false
TRAFFIC_API_BILLING_ACKNOWLEDGED=false
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Details: docs/TOMTOM_TRAFFIC_SETUP.md
