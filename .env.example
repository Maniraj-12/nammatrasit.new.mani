# No credentials are needed for the static GTFS journey planner.

# Optional current road traffic estimates (Google Maps Platform).
# Routes API key is PRIVATE: server-only, never prefix with VITE_.
# Obtain and store your own key in the deployed server's secrets.
GOOGLE_MAPS_ROUTES_API_KEY=

# Both flags must be true before the server makes billable Google calls.
# Set quotas and authentication/rate limiting BEFORE enabling publicly.
TRAFFIC_API_ENABLED=false
TRAFFIC_API_BILLING_ACKNOWLEDGED=false

# The ONLY public Google key: restrict to your website HTTP referrers and
# Maps JavaScript API. It is visible in the browser bundle by design.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# See docs/TRAFFIC_AWARE_COMPARISON.md
